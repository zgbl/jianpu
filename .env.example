# Copy to .env and fill in the API keys you want to use. .env is ignored by Git.
GEMINI_API_KEY=
OPENAI_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional model overrides. The page defaults are Gemini 3.6 Flash,
# GPT-6 Luna, Qwen3.8-Flash and DeepSeek-Flash.
# GEMINI_MODEL=gemini-3.6-flash
# OPENAI_MODEL=gpt-6-luna
# QWEN_MODEL=qwen3.8-flash
# DEEPSEEK_MODEL=deepseek-flash
# OpenRouter models use the full catalog ID, for example: google/gemini-3.6-flash
# OPENROUTER_MODEL=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
